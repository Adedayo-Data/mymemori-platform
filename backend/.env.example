# Database Configuration (Neon)
DB_URL=postgresql://username:password@your-neon-host/database
DB_USERNAME=your-username
DB_PASSWORD=your-password

# JWT Configuration
# Generate a secure random string for production: openssl rand -base64 32
JWT_SECRET=your-super-secure-random-256-bit-secret-here
JWT_EXPIRATION=86400000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL (used to build password reset links)
FRONTEND_URL=https://mymemori.site

# Google OAuth (Sign in with Google)
# Get this from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn-here
